# Copy to .env and fill in. Same Wasabi keys can be used as in SSS.
DATABASE_URL=postgresql://user:password@localhost:5432/surgical_cal
SECRET_KEY=your-secret-key-for-jwt

# Optional
# BASE_URL=https://cal.example.com
# MAGIC_LINK_EXPIRE_HOURS=168
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=admin@example.com

# Wasabi S3 Backup (use full URL; if omitted, uses https://s3.REGION.wasabisys.com)
WASABI_KEY_ID=
WASABI_SECRET=
WASABI_BUCKET=mfsa-cal
WASABI_REGION=us-east-1
# WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com

