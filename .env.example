# Copy to .env and fill in. Same Wasabi keys can be used as in SSS.
# For the standalone VM compose, keep CAL_DB_* and DATABASE_URL aligned.
CAL_DB_NAME=cal_prod
CAL_DB_USER=cal_app
CAL_DB_PASSWORD=change_me_cal_db_password
CAL_BIND_HOST=0.0.0.0
DATABASE_URL=postgresql://cal_app:change_me_cal_db_password@cal_postgres:5432/cal_prod
APRIMA_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=10.0.1.25,56617;DATABASE=PRM;UID=aprima_read;PWD=change_me;Encrypt=yes;TrustServerCertificate=yes;Connection Timeout=30;
SECRET_KEY=your-secret-key-for-jwt

# Optional Aprima main-office / Surgery One site filter (comma-separated name fragments)
# Live Aprima site for Friday office patients is "Clermont Office".
# APRIMA_MAIN_OFFICE_SITE=Clermont Office,Winter Garden Clinic,Winter Garden,Main Office,Main Clinic

# Optional
# BASE_URL=https://cal.example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=admin@example.com
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_AUTH_KEY_PATH=/opt/cal/secrets/AuthKey_XXXXXXXXXX.p8
# APNS_AUTH_KEY_P8=
# APNS_BUNDLE_ID=com.midfloridasurgical.calnative
# APNS_USE_SANDBOX=false
# APNS_ALERT_SOUND=cal_alert.wav

# Wasabi S3 Backup (use full URL; if omitted, uses https://s3.REGION.wasabisys.com)
WASABI_KEY_ID=
WASABI_SECRET=
WASABI_BUCKET=mfsa-cal
WASABI_REGION=us-east-1
# WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com
