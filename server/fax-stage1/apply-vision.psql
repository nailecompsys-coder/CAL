\set ON_ERROR_STOP on

BEGIN;

DELETE FROM fax_stage1.vision_results
WHERE request_id IN (
    SELECT request_id FROM fax_stage1.vision_requests WHERE fax_id = :'fax_id'::integer
);

WITH parsed AS (
    SELECT
        request.request_id,
        imported.raw_result,
        nullif(btrim(imported.raw_result->>'patient_name'), '') AS patient_name,
        nullif(regexp_replace(coalesce(imported.raw_result->>'source_patient_id', ''), '[^0-9]', '', 'g'), '') AS source_patient_id,
        CASE WHEN imported.raw_result->>'patient_dob' ~ '^\d{4}-\d{2}-\d{2}$'
             THEN (imported.raw_result->>'patient_dob')::date END AS patient_dob,
        CASE WHEN imported.raw_result->>'activity_date' ~ '^\d{4}-\d{2}-\d{2}$'
             THEN (imported.raw_result->>'activity_date')::date END AS activity_date,
        CASE WHEN imported.raw_result->>'start_time' ~ '^\d{2}:\d{2}$'
             THEN (imported.raw_result->>'start_time')::time END AS start_time,
        nullif(btrim(imported.raw_result->>'procedure_text'), '') AS procedure_text,
        nullif(btrim(imported.raw_result->>'room_text'), '') AS room_text,
        coalesce(imported.raw_result->>'confidence', 'low') AS confidence,
        ARRAY(SELECT jsonb_array_elements_text(coalesce(imported.raw_result->'uncertain_fields', '[]'::jsonb))) AS api_uncertain
    FROM fax_stage1.vision_requests AS request
    JOIN fax_stage1.vision_response_import AS imported USING (request_id)
    WHERE request.fax_id = :'fax_id'::integer
), gated AS (
    SELECT
        parsed.*,
        ARRAY(
            SELECT DISTINCT issue
            FROM unnest(parsed.api_uncertain || array_remove(ARRAY[
                CASE WHEN patient_name IS NULL THEN 'patient_name' END,
                CASE WHEN source_patient_id IS NULL OR length(source_patient_id) < 6 THEN 'source_patient_id' END,
                CASE WHEN patient_dob IS NULL OR patient_dob > activity_date THEN 'patient_dob' END,
                CASE WHEN activity_date IS NULL THEN 'activity_date' END,
                CASE WHEN start_time IS NULL THEN 'start_time' END,
                CASE WHEN procedure_text IS NULL THEN 'procedure_text' END,
                CASE WHEN room_text IS NULL THEN 'room_text' END
            ], NULL)) AS issue
        ) AS uncertain_fields
    FROM parsed
)
INSERT INTO fax_stage1.vision_results (
    request_id, provider, api_call, patient_name, source_patient_id,
    patient_dob, activity_date, start_time, procedure_text, room_text,
    confidence, uncertain_fields, raw_result
)
SELECT
    request_id, 'openai_responses_api', true, patient_name, source_patient_id,
    patient_dob, activity_date, start_time, procedure_text, room_text,
    confidence, uncertain_fields, raw_result
FROM gated;

UPDATE fax_stage1.vision_requests AS request
SET request_status = CASE
    WHEN result.uncertain_fields = ARRAY[]::text[] THEN 'completed'
    ELSE 'unresolved'
END
FROM fax_stage1.vision_results AS result
WHERE result.request_id = request.request_id
  AND request.fax_id = :'fax_id'::integer;

UPDATE fax_stage1.defects AS defect
SET defect_status = CASE WHEN result.uncertain_fields = ARRAY[]::text[] THEN 'resolved' ELSE 'open' END,
    resolution_detail = CASE
        WHEN result.uncertain_fields = ARRAY[]::text[] THEN 'Flagged crop verified by OpenAI Responses API and SQL validation gates.'
        ELSE format('Vision response remains uncertain: %s', result.uncertain_fields)
    END,
    resolved_at = CASE WHEN result.uncertain_fields = ARRAY[]::text[] THEN now() ELSE NULL END
FROM fax_stage1.vision_requests AS request
JOIN fax_stage1.vision_results AS result USING (request_id)
WHERE defect.candidate_row_id = request.candidate_row_id
  AND defect.fax_id = :'fax_id'::integer
  AND defect.defect_code <> 'duplicate_case_key_within_fax';

UPDATE fax_stage1.resolved_rows AS resolved
SET patient_name = coalesce(result.patient_name, resolved.patient_name),
    source_patient_id = coalesce(result.source_patient_id, resolved.source_patient_id),
    patient_dob = coalesce(result.patient_dob, resolved.patient_dob),
    activity_date = coalesce(result.activity_date, resolved.activity_date),
    start_time = coalesce(result.start_time, resolved.start_time),
    session = CASE
        WHEN result.start_time < TIME '12:00' THEN 'am'
        WHEN result.start_time IS NOT NULL THEN 'pm'
        ELSE resolved.session
    END,
    procedure_text = coalesce(result.procedure_text, resolved.procedure_text),
    room_text = coalesce(result.room_text, resolved.room_text),
    activity_type = CASE
        WHEN upper(coalesce(result.room_text, resolved.room_text)) ~ '(CLMMFLGS|MGALTGS|MGWGDGS|AHMGGENSRG|MGLKMGENSURG|MGORLGSDLGIO)' THEN 'clinic'
        WHEN upper(coalesce(result.room_text, resolved.room_text)) ~ '(ENDO|OSOR)' THEN 'surgical'
        WHEN upper(coalesce(result.room_text, resolved.room_text)) ~ '\m(WGD|MIN|ALT|APK|AP|AL|MN|WG)\M.*\mS[0-9]+' THEN 'surgical'
        ELSE resolved.activity_type
    END,
    resolution_method = 'openai_responses_api',
    resolution_status = CASE WHEN result.uncertain_fields = ARRAY[]::text[] THEN 'resolved' ELSE 'unresolved' END,
    unresolved_fields = result.uncertain_fields
FROM fax_stage1.vision_requests AS request
JOIN fax_stage1.vision_results AS result USING (request_id)
WHERE resolved.candidate_row_id = request.candidate_row_id
  AND resolved.fax_id = :'fax_id'::integer;

UPDATE fax_stage1.documents
SET status = CASE
    WHEN EXISTS (SELECT 1 FROM fax_stage1.resolved_rows WHERE fax_id = :'fax_id'::integer AND resolution_status = 'unresolved')
        THEN 'stage1_complete_with_unresolved'
    ELSE 'stage1_complete_pre_card_match'
END
WHERE fax_id = :'fax_id'::integer;

COMMIT;
