-- Persistent Stage-1 fax ingestion schema. No schedule/card tables are referenced.

BEGIN;

CREATE SCHEMA IF NOT EXISTS fax_stage1;

CREATE TABLE IF NOT EXISTS fax_stage1.documents (
    fax_id integer PRIMARY KEY,
    source_sha256 text NOT NULL,
    source_page_count integer NOT NULL CHECK (source_page_count > 0),
    source_reference text NOT NULL,
    status text NOT NULL DEFAULT 'ocr_loading',
    created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS fax_stage1.pages (
    fax_id integer NOT NULL REFERENCES fax_stage1.documents(fax_id),
    page_number integer NOT NULL,
    width_px integer NOT NULL,
    height_px integer NOT NULL,
    token_count integer NOT NULL DEFAULT 0,
    average_confidence numeric(5,1),
    page_kind text,
    PRIMARY KEY (fax_id, page_number)
);

CREATE TABLE IF NOT EXISTS fax_stage1.ocr_tokens (
    fax_id integer NOT NULL REFERENCES fax_stage1.documents(fax_id),
    fax_page integer NOT NULL,
    level integer,
    ocr_page_num integer,
    block_num integer,
    par_num integer,
    line_num integer,
    word_num integer,
    left_px integer,
    top_px integer,
    width_px integer,
    height_px integer,
    confidence numeric,
    token_text text
);

CREATE INDEX IF NOT EXISTS ocr_tokens_page_position
    ON fax_stage1.ocr_tokens(fax_id, fax_page, top_px, left_px);

CREATE TABLE IF NOT EXISTS fax_stage1.ocr_import (
    level integer,
    page_num integer,
    block_num integer,
    par_num integer,
    line_num integer,
    word_num integer,
    left_px integer,
    top_px integer,
    width_px integer,
    height_px integer,
    confidence numeric,
    token_text text
);

CREATE TABLE IF NOT EXISTS fax_stage1.ocr_lines (
    fax_id integer NOT NULL,
    fax_page integer NOT NULL,
    block_num integer NOT NULL,
    par_num integer NOT NULL,
    line_num integer NOT NULL,
    left_px integer NOT NULL,
    top_px integer NOT NULL,
    width_px integer NOT NULL,
    height_px integer NOT NULL,
    confidence numeric(5,1),
    raw_text text NOT NULL,
    PRIMARY KEY (fax_id, fax_page, block_num, par_num, line_num)
);

CREATE TABLE IF NOT EXISTS fax_stage1.surgeon_sections (
    section_id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    fax_id integer NOT NULL,
    section_number integer NOT NULL,
    surgeon_name_ocr text NOT NULL,
    start_page integer NOT NULL,
    end_page integer NOT NULL,
    header_text text NOT NULL,
    header_confidence numeric(5,1),
    review_status text NOT NULL DEFAULT 'ready',
    review_issues text[] NOT NULL DEFAULT '{}',
    UNIQUE (fax_id, section_number)
);

CREATE TABLE IF NOT EXISTS fax_stage1.page_sections (
    fax_id integer NOT NULL,
    page_number integer NOT NULL,
    section_id bigint REFERENCES fax_stage1.surgeon_sections(section_id),
    PRIMARY KEY (fax_id, page_number)
);

CREATE TABLE IF NOT EXISTS fax_stage1.candidate_rows (
    candidate_row_id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    fax_id integer NOT NULL,
    section_id bigint NOT NULL REFERENCES fax_stage1.surgeon_sections(section_id),
    section_row_number integer NOT NULL,
    source_page integer NOT NULL,
    source_top_px integer NOT NULL,
    source_bottom_px integer NOT NULL,
    surgeon_name text NOT NULL,
    patient_name_ocr text,
    source_patient_id_ocr text,
    patient_dob_ocr text,
    activity_date_ocr text,
    start_time_ocr text,
    procedure_ocr text,
    room_ocr text,
    patient_name text,
    source_patient_id text,
    patient_dob date,
    activity_date date,
    start_time time,
    session text,
    activity_type text,
    procedure_text text,
    room_text text,
    ocr_confidence numeric(5,1),
    review_status text NOT NULL,
    review_issues text[] NOT NULL DEFAULT '{}',
    source_text text NOT NULL,
    UNIQUE (fax_id, section_id, section_row_number)
);

CREATE TABLE IF NOT EXISTS fax_stage1.vision_requests (
    request_id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    fax_id integer NOT NULL,
    candidate_row_id bigint NOT NULL REFERENCES fax_stage1.candidate_rows(candidate_row_id),
    crop_path text NOT NULL,
    request_status text NOT NULL DEFAULT 'pending',
    requested_fields text[] NOT NULL,
    created_at timestamptz NOT NULL DEFAULT now(),
    UNIQUE (fax_id, candidate_row_id)
);

CREATE TABLE IF NOT EXISTS fax_stage1.vision_results (
    result_id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    request_id bigint NOT NULL REFERENCES fax_stage1.vision_requests(request_id),
    provider text NOT NULL,
    api_call boolean NOT NULL,
    patient_name text,
    source_patient_id text,
    patient_dob date,
    activity_date date,
    start_time time,
    procedure_text text,
    room_text text,
    confidence text,
    uncertain_fields text[] NOT NULL DEFAULT '{}',
    raw_result jsonb NOT NULL,
    created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS fax_stage1.vision_response_import (
    request_id bigint PRIMARY KEY,
    raw_result jsonb NOT NULL,
    imported_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS fax_stage1.reference_matches (
    match_id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    fax_id integer NOT NULL,
    candidate_row_id bigint NOT NULL,
    source_system text NOT NULL,
    source_record_key text NOT NULL,
    match_score integer NOT NULL,
    matched_on text[] NOT NULL DEFAULT '{}',
    reference_patient_name text,
    reference_source_patient_id text,
    reference_patient_dob date,
    reference_activity_date date,
    reference_start_time time,
    reference_procedure_text text,
    reference_room_text text,
    selected boolean NOT NULL DEFAULT false,
    created_at timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS reference_matches_fax_candidate
    ON fax_stage1.reference_matches(fax_id, candidate_row_id, selected);

CREATE TABLE IF NOT EXISTS fax_stage1.defects (
    defect_id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    fax_id integer NOT NULL,
    source_page integer,
    section_id bigint,
    candidate_row_id bigint,
    defect_code text NOT NULL,
    defect_detail text NOT NULL,
    severity text NOT NULL CHECK (severity IN ('info', 'warning', 'blocking')),
    defect_status text NOT NULL DEFAULT 'open'
        CHECK (defect_status IN ('open', 'resolved', 'accepted')),
    resolution_detail text,
    resolved_at timestamptz,
    created_at timestamptz NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS fax_stage1.resolved_rows (
    candidate_row_id bigint PRIMARY KEY,
    fax_id integer NOT NULL,
    section_id bigint NOT NULL,
    section_row_number integer NOT NULL,
    source_page integer NOT NULL,
    surgeon_name text NOT NULL,
    patient_name text,
    source_patient_id text,
    patient_dob date,
    activity_date date,
    start_time time,
    session text,
    activity_type text,
    procedure_text text,
    room_text text,
    resolution_method text NOT NULL,
    resolution_status text NOT NULL,
    unresolved_fields text[] NOT NULL DEFAULT '{}',
    source_text text NOT NULL
);

COMMIT;
